# ============================================
# 生产环境配置模板
# 复制此文件为 .env 并修改配置值
# Linux/Mac: cp .env.example .env
# Windows:   Copy-Item .env.example .env
# ============================================

# ---------- 必填配置 ----------

# 数据库密码（必填）
MYSQL_ROOT_PASSWORD=your_secure_password_here

# JWT签名密钥（必填，至少32字符）
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-at-least-32-chars

# CORS允许的来源（生产环境必须配置具体域名，不要使用 *）
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ---------- 可选配置 ----------

# 数据库名称
MYSQL_DATABASE=elderly_care

# 端口配置
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=8081

# Spring环境（生产环境建议设为 prod）
SPRING_PROFILES_ACTIVE=prod

# 日志级别（生产环境建议 info 或 warn）
LOG_LEVEL=info

# MyBatis日志（生产环境建议关闭SQL日志）
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
